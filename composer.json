{
    "name": "ibaiicb/laravel-make-action",
    "description": "A Laravel package that adds a make:action Artisan command to generate Action classes following the single responsibility principle.",
    "keywords": [
        "laravel",
        "package",
        "artisan",
        "action",
        "make"
    ],
    "homepage": "https://github.com/ibaiicb/laravel-make-action",
    "license": "MIT",
    "authors": [
        {
            "name": "Ibai Cáceres Benito",
            "email": "ibaicaceresbenito2002@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelMakeAction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelMakeAction\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "@test --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelMakeAction\\LaravelMakeActionServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
